# Single-host self-hosting defaults for infra/compose.yml.
# Generate a populated infra/.env automatically with:
#   python infra/scripts/init_env.py
# Or copy to infra/.env and replace every CHANGE_ME value before starting.

# --- Images ---
HOMEDATABASE_IMAGE=homedatabase-api:local
HOMEDATABASE_WEB_IMAGE=homedatabase-web:local

# --- Core Ledger Mode & Origin ---
# Use "local" for HTTP localhost/LAN access (auth stays enabled; dev bypass is always off).
# Use "production" only with HTTPS (e.g. infra/compose.tls.yml or an HTTPS reverse proxy).
HOMEDATABASE_ENVIRONMENT=local
HOMEDATABASE_SESSION_COOKIE_SECURE=false

# Caddy site address: ":80" serves plain HTTP for localhost/LAN without auto-HTTPS certs.
# Set to your real domain (e.g. finance.example.com) when pairing with infra/compose.tls.yml.
HOMEDATABASE_CADDY_SITE=:80
HOMEDATABASE_PUBLIC_HOST=finance.example.com
HOMEDATABASE_HTTP_BIND=127.0.0.1
HOMEDATABASE_HTTP_PORT=8080
HOMEDATABASE_HTTPS_PORT=443
HOMEDATABASE_API_BIND=127.0.0.1
HOMEDATABASE_API_PORT=8000

HOMEDATABASE_WEBAUTHN_RP_ID=localhost
HOMEDATABASE_WEBAUTHN_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
HOMEDATABASE_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# --- Database & Broker (URL-safe passwords only) ---
HOMEDATABASE_DB_NAME=homedatabase
HOMEDATABASE_DB_USER=homedatabase
HOMEDATABASE_DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
HOMEDATABASE_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- Encryption Keys (two different 32-byte URL-safe base64 values, no padding) ---
HOMEDATABASE_SOURCE_ENCRYPTION_KEY=CHANGE_ME_SOURCE_FILE_KEY
HOMEDATABASE_BACKUP_ENCRYPTION_KEY=CHANGE_ME_BACKUP_KEY

# --- Optional AI / Codex CLI OCR Profile (--profile ai-ocr) ---
# Keep false until codex_auth has been authenticated via:
#   docker compose --env-file infra/.env -f infra/compose.yml --profile ai-ocr run --rm ocr-runner codex login --device-auth
HOMEDATABASE_OCR_ENABLED=false
HOMEDATABASE_OCR_IMAGE=homedatabase-ocr:local
HOMEDATABASE_CODEX_CLI_VERSION=0.145.0
HOMEDATABASE_OCR_TIMEOUT_SECONDS=600
HOMEDATABASE_OCR_MAX_PAGES=200
HOMEDATABASE_OCR_PAGES_PER_JOB=10
HOMEDATABASE_OCR_MAX_TRANSACTIONS=5000
HOMEDATABASE_OCR_MAX_IMAGE_PIXELS=20000000
HOMEDATABASE_OCR_RUNNER_POLL_SECONDS=0.5
HOMEDATABASE_OCR_JOB_STALE_SECONDS=3600
# Empty uses the authenticated Codex CLI default model.
HOMEDATABASE_OCR_CODEX_MODEL=

# --- Source Retention & Encrypted Backups (--profile maintenance) ---
HOMEDATABASE_SOURCE_RETENTION_DAYS=90
HOMEDATABASE_BACKUP_LOCATION_KIND=local
HOMEDATABASE_BACKUP_KEEP_HOURLY=48
HOMEDATABASE_BACKUP_KEEP_DAILY=30
HOMEDATABASE_BACKUP_KEEP_MONTHLY=12
HOMEDATABASE_BACKUP_MIN_FREE_BYTES=536870912
HOMEDATABASE_BACKUP_ORPHAN_GRACE_SECONDS=300

# --- Auth Rate Limits (enforced when HOMEDATABASE_ENVIRONMENT=production) ---
HOMEDATABASE_AUTH_RATE_LIMIT_ATTEMPTS=10
HOMEDATABASE_AUTH_RATE_LIMIT_IP_ATTEMPTS=30
HOMEDATABASE_AUTH_RATE_LIMIT_SUBJECT_ATTEMPTS=50
