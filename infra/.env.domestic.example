# Copy to infra/.env.domestic on the domestic server and replace every CHANGE_ME value.
HOMEDATABASE_IMAGE=homedatabase-api:local
HOMEDATABASE_WEB_IMAGE=homedatabase-web:local
HOMEDATABASE_PUBLIC_HOST=finance.example.com

HOMEDATABASE_DB_NAME=homedatabase
HOMEDATABASE_DB_USER=homedatabase
HOMEDATABASE_DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
HOMEDATABASE_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Two different 32-byte URL-safe base64 values (without padding).
HOMEDATABASE_SOURCE_ENCRYPTION_KEY=CHANGE_ME_SOURCE_FILE_KEY
HOMEDATABASE_BACKUP_ENCRYPTION_KEY=CHANGE_ME_BACKUP_KEY

# Optional Codex CLI OCR profile. Authenticate the codex_auth volume before enabling.
HOMEDATABASE_OCR_ENABLED=false
HOMEDATABASE_OCR_IMAGE=homedatabase-ocr:local
HOMEDATABASE_CODEX_CLI_VERSION=0.145.0
HOMEDATABASE_OCR_TIMEOUT_SECONDS=600
HOMEDATABASE_OCR_MAX_PAGES=200
HOMEDATABASE_OCR_PAGES_PER_JOB=10
HOMEDATABASE_OCR_MAX_TRANSACTIONS=5000
HOMEDATABASE_OCR_MAX_IMAGE_PIXELS=20000000
HOMEDATABASE_OCR_RUNNER_POLL_SECONDS=0.5
HOMEDATABASE_OCR_JOB_STALE_SECONDS=3600
# Empty means use the authenticated Codex CLI default model.
HOMEDATABASE_OCR_CODEX_MODEL=

# Keep Redis local for the first domestic-only release.
HOMEDATABASE_TUNNEL_BIND_IP=127.0.0.1
HOMEDATABASE_REDIS_TUNNEL_PORT=6379

HOMEDATABASE_HTTP_PORT=80
HOMEDATABASE_HTTPS_PORT=443
