# Local-only example. Copy to backend/.env or export these variables in the shell.
HOMEDATABASE_ENVIRONMENT=local
HOMEDATABASE_DATABASE_URL=sqlite+pysqlite:///./data/homedatabase-dev.sqlite3
HOMEDATABASE_DATABASE_ECHO=false
HOMEDATABASE_AUTO_CREATE_SCHEMA=false
HOMEDATABASE_SEED_DEMO=false
HOMEDATABASE_BOOTSTRAP_PASSWORD=

HOMEDATABASE_API_PREFIX=/api
HOMEDATABASE_BASE_CURRENCY=CNY
# Development identity bypass. Production must leave this empty.
HOMEDATABASE_DEV_MEMBER_ID=

HOMEDATABASE_SESSION_COOKIE_NAME=hd_session
HOMEDATABASE_SESSION_COOKIE_SECURE=false
HOMEDATABASE_SESSION_TTL_SECONDS=2592000

HOMEDATABASE_WEBAUTHN_RP_ID=localhost
HOMEDATABASE_WEBAUTHN_RP_NAME=HomeDatabase
HOMEDATABASE_WEBAUTHN_ORIGINS=["http://localhost:5200","http://127.0.0.1:5200"]
HOMEDATABASE_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
HOMEDATABASE_WEBAUTHN_CHALLENGE_TTL_SECONDS=300

HOMEDATABASE_REDIS_URL=redis://127.0.0.1:6379/0
HOMEDATABASE_TASK_ALWAYS_EAGER=true
HOMEDATABASE_AUTH_RATE_LIMIT_ATTEMPTS=10
HOMEDATABASE_AUTH_RATE_LIMIT_IP_ATTEMPTS=30
HOMEDATABASE_AUTH_RATE_LIMIT_SUBJECT_ATTEMPTS=50
HOMEDATABASE_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
HOMEDATABASE_MAX_JSON_BODY_BYTES=1048576
HOMEDATABASE_SOURCE_ARCHIVE_DIR=data/source-files
HOMEDATABASE_SOURCE_RETENTION_DAYS=90
# URL-safe base64 encoding of 32 random bytes. Never commit a real key.
HOMEDATABASE_SOURCE_ENCRYPTION_KEY=
HOMEDATABASE_SOURCE_MAX_FILES=10
HOMEDATABASE_SOURCE_MAX_FILE_BYTES=26214400
HOMEDATABASE_SOURCE_MAX_TOTAL_BYTES=104857600
HOMEDATABASE_SOURCE_MAX_ROWS=50000
HOMEDATABASE_SOURCE_MAX_UNCOMPRESSED_BYTES=104857600
HOMEDATABASE_OCR_ENABLED=false
HOMEDATABASE_OCR_JOBS_DIR=data/ocr-jobs
HOMEDATABASE_OCR_TIMEOUT_SECONDS=600
HOMEDATABASE_OCR_MAX_PAGES=200
HOMEDATABASE_OCR_PAGES_PER_JOB=10
HOMEDATABASE_OCR_MAX_TRANSACTIONS=5000
HOMEDATABASE_OCR_MAX_IMAGE_PIXELS=20000000
HOMEDATABASE_OCR_RUNNER_POLL_SECONDS=0.5
HOMEDATABASE_OCR_JOB_STALE_SECONDS=3600
HOMEDATABASE_BACKUP_DIR=data/backups
# Use a different URL-safe base64 32-byte key from the source-file key.
HOMEDATABASE_BACKUP_ENCRYPTION_KEY=
HOMEDATABASE_BACKUP_LOCATION_KIND=tencent
HOMEDATABASE_BACKUP_KEEP_HOURLY=48
HOMEDATABASE_BACKUP_KEEP_DAILY=30
HOMEDATABASE_BACKUP_KEEP_MONTHLY=12
HOMEDATABASE_BACKUP_MIN_FREE_BYTES=536870912
HOMEDATABASE_BACKUP_ORPHAN_GRACE_SECONDS=300
HOMEDATABASE_PG_DUMP_PATH=pg_dump
HOMEDATABASE_PG_RESTORE_PATH=pg_restore

# Production baseline (set through the deployment secret store, not this file):
# HOMEDATABASE_ENVIRONMENT=production
# HOMEDATABASE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/homedatabase
# HOMEDATABASE_AUTO_CREATE_SCHEMA=false
# HOMEDATABASE_DEV_MEMBER_ID=
# HOMEDATABASE_SESSION_COOKIE_SECURE=true
# HOMEDATABASE_WEBAUTHN_RP_ID=finance.example.com
# HOMEDATABASE_WEBAUTHN_ORIGINS=["https://finance.example.com"]
# HOMEDATABASE_ALLOWED_HOSTS=["finance.example.com"]
# HOMEDATABASE_SOURCE_ENCRYPTION_KEY=<secret>
# HOMEDATABASE_BACKUP_ENCRYPTION_KEY=<different-secret>
# HOMEDATABASE_TASK_ALWAYS_EAGER=false
